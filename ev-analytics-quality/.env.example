# Required in production: a long random string used to sign login sessions.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: turns on AI-written analysis, the Sage assistant, the written VIN summary and live web research.
# Without it, analysis falls back to rule-based text and the web research section says it is switched off.
ANTHROPIC_API_KEY=
# The model must support the web search tool for live research.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: set to 1 to list the demo accounts on the login screen. Leave off on a public URL.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=0
